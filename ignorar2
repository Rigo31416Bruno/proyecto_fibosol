<?php
header('Content-Type: application/json; charset=utf-8');

require __DIR__ . '/../db/conexion.php';
require __DIR__ . '/correo.php'; // helper que contiene sendVerificationEmail()

try {
    $usuario    = isset($_POST['usuario']) ? trim($_POST['usuario']) : '';
    $email      = isset($_POST['email']) ? trim($_POST['email']) : '';
    $contrasena = isset($_POST['contrasena']) ? $_POST['contrasena'] : '';

    if ($usuario === '' || $email === '' || $contrasena === '') {
        http_response_code(400);
        echo json_encode(['success' => false, 'message' => 'Complete todos los campos.']);
        exit;
    }
    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        http_response_code(400);
        echo json_encode(['success' => false, 'message' => 'Email inválido.']);
        exit;
    }
    if (strlen($contrasena) < 8) {
        http_response_code(400);
        echo json_encode(['success' => false, 'message' => 'La contraseña debe tener al menos 8 caracteres.']);
        exit;
    }

    $dbObj = new Conexion();
    $conn = $dbObj->getConnection();

    $stmt = $conn->prepare('SELECT idCuenta FROM usuarios WHERE correo = ? OR nombre = ? LIMIT 1');
    if (!$stmt) throw new RuntimeException('Prepare failed: ' . $conn->error);
    $stmt->bind_param('ss', $email, $usuario);
    $stmt->execute();
    $stmt->store_result();
    if ($stmt->num_rows > 0) {
        http_response_code(409);
        echo json_encode(['success' => false, 'message' => 'El usuario o el correo ya existen.']);
        $stmt->close();
        exit;
    }
    $stmt->close();

    $hash = password_hash($contrasena, PASSWORD_DEFAULT);
    $insert = $conn->prepare('INSERT INTO usuarios (nombre, correo, contrasena, correo_verificado) VALUES (?, ?, ?, 0)');
    if (!$insert) throw new RuntimeException('Prepare failed: ' . $conn->error);
    $insert->bind_param('sss', $usuario, $email, $hash);
    $ok = $insert->execute();
    if (!$ok) {
        http_response_code(500);
        echo json_encode(['success' => false, 'message' => 'Error al guardar en la base de datos.']);
        $insert->close();
        exit;
    }
    $userId = $conn->insert_id;
    $insert->close();

    $token = bin2hex(random_bytes(32));
    $expira = (new DateTime('+24 hours'))->format('Y-m-d H:i:s');

    $upd = $conn->prepare('UPDATE usuarios SET verification_token = ?, token_expires = ? WHERE idCuenta = ?');
    if (!$upd) throw new RuntimeException('Prepare failed: ' . $conn->error);
    $upd->bind_param('ssi', $token, $expira, $userId);
    $upd->execute();
    $upd->close();

    $sent = sendVerificationEmail($email, $usuario, $token);

    http_response_code(201);
    if ($sent) {
        echo json_encode(['success' => true, 'message' => 'Registrado. Revisa tu correo para verificar la cuenta.']);
    } else {
        echo json_encode(['success' => true, 'message' => 'Registrado. No se pudo enviar el correo de verificación, intenta reenviarlo desde tu cuenta.']);
    }
    exit;

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['success' => false, 'message' => 'Error del servidor.'.$e]);
    exit;
}
?>
